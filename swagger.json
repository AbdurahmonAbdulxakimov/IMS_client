definitions:
  User:
    required:
    - username
    type: object
    properties:
      user_uuid:
        title: User uuid
        type: string
        format: uuid
        readOnly: true
      username:
        title: Username
        type: string
        maxLength: 30
        minLength: 1
      email:
        title: Email
        type: string
        maxLength: 120
      first_name:
        title: First name
        type: string
        maxLength: 60
      last_name:
        title: Last name
        type: string
        maxLength: 60
      role:
        title: Role
        type: string
        enum:
        - superuser
        - admin
        - manager
        - stuff
      status:
        title: Status
        type: boolean
      last_login:
        title: Last login
        type: string
        format: date-time
        readOnly: true
        x-nullable: true
      created_date:
        title: Created date
        type: string
        format: date
        readOnly: true
  UserActivity:
    required:
    - action_type
    - action_description
    type: object
    properties:
      activity_uuid:
        title: Activity uuid
        type: string
        format: uuid
        readOnly: true
      user:
        $ref: '#/definitions/User'
      user_uuid:
        title: User uuid
        type: string
        format: uuid
      action_type:
        title: Action type
        type: string
        enum:
        - login
        - logout
        - create
        - update
        - delete
        - view
        - download
        - upload
        - other
      action_description:
        title: Action description
        type: string
        minLength: 1
      ip_address:
        title: Ip address
        type: string
        minLength: 1
        x-nullable: true
      user_agent:
        title: User agent
        type: string
      request_path:
        title: Request path
        type: string
        maxLength: 500
      request_method:
        title: Request method
        type: string
        maxLength: 10
      status_code:
        title: Status code
        type: integer
        maximum: 2147483647
        minimum: -2147483648
        x-nullable: true
      created_at:
        title: Created at
        type: string
        format: date-time
        readOnly: true
  RolePermission:
    required:
    - role
    - permission
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      role:
        title: Role
        type: string
        enum:
        - superuser
        - admin
        - manager
        - stuff
      permission:
        title: Permission
        type: string
        enum:
        - user_create
        - user_read
        - user_update
        - user_delete
        - permission_assign
        - permission_revoke
        - activity_view
        - activity_export
        - admin_access
        - stock_create
        - stock_read
        - stock_update
        - stock_delete
        - client_create
        - client_read
        - client_update
        - client_delete
        - transaction_create
        - transaction_read
        - transaction_update
        - transaction_delete
        - product_create
        - product_read
        - product_update
        - product_delete
        - product_category_create
        - product_category_read
        - product_category_update
        - product_category_delete
        - warehouse_create
        - warehouse_read
        - warehouse_update
        - warehouse_delete
      permission_label:
        title: Permission label
        type: string
        readOnly: true
        minLength: 1
      created_date:
        title: Created date
        type: string
        format: date
        readOnly: true
  CustomTokenObtainPair:
    required:
    - username
    - password
    type: object
    properties:
      username:
        title: Username
        type: string
        minLength: 1
      password:
        title: Password
        type: string
        minLength: 1
  TokenRefresh:
    required:
    - refresh
    type: object
    properties:
      refresh:
        title: Refresh
